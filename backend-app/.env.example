# Backend configuration for BinhTinhStore
NODE_ENV=development
PORT=3000

# SQL Server - khớp với dbms-env/docker-compose.yml
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=ecommerce_dbms
SQL_USER=sa
SQL_PASSWORD=SuperStrongPassword123!
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERT=true

# MongoDB - khớp với dbms-env/docker-compose.yml
MONGO_URI=mongodb://admin:adminpassword@localhost:27017/ecommerce_mongo?authSource=admin

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d
# Cookie refresh token: Secure mặc định khi NODE_ENV=production; đặt false nếu thử production qua http
# COOKIE_SECURE=true
# Frontend khác origin với API (không qua proxy) thì liệt kê origin, cách nhau bằng dấu phẩy
# CORS_ORIGINS=http://localhost:5173

# Frontend/backend URLs
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# VNPay Sandbox - điền credential thật nếu muốn test VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/api/v1/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:3000/api/v1/payments/vnpay/ipn

# Production đặt false: chỉ tin IPN. Dev để trống = true vì sandbox không gọi IPN về localhost được.
VNPAY_UPDATE_ON_RETURN=

# Đơn VNPay chưa thanh toán sau ngần này phút sẽ tự huỷ và hoàn kho
PAYMENT_EXPIRE_MINUTES=30

# Phí ship và mốc miễn phí ship (VND) - server tự tính, client không gửi lên
SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=3000000

# Báo giá cấu hình Build PC giữ giá trong ngần này giờ
QUOTE_VALID_HOURS=48

# Số request tối đa mỗi IP trong 15 phút cho toàn bộ API (đăng nhập có giới hạn riêng chặt hơn)
RATE_LIMIT_MAX=1500

# Số reverse proxy đứng trước API (1 khi chạy sau nginx trong docker-compose). Để trống nếu gọi API trực tiếp.
TRUST_PROXY=

# Thông tin người bán hiển thị trên website (bắt buộc công khai khi bán thật, Luật TMĐT 2025 Điều 11)
STORE_LEGAL_NAME=
STORE_TAX_CODE=
STORE_ADDRESS=
STORE_PHONE=
STORE_EMAIL=
STORE_REPRESENTATIVE=
# Phiên bản điều khoản mua hàng; đổi khi sửa nội dung điều khoản
STORE_TERMS_VERSION=2026-11-11
STORE_PROVINCE=TP. Hồ Chí Minh
DELIVERY_DAYS_LOCAL=1–2
DELIVERY_DAYS_OTHER=2–5
RETURN_DAYS=7
COMPLAINT_RESPONSE_DAYS=3
PRICES_INCLUDE_TAX=true

# Dịch vụ tại nhà (trong STORE_PROVINCE): số lịch mỗi khung giờ = số kỹ thuật viên; số ngày mở đặt lịch
SERVICE_SLOT_CAPACITY=2
SERVICE_BOOKING_DAYS=14

# Chu kỳ so giá cho tính năng "theo dõi giá" (mili giây)
PRICE_WATCH_SWEEP_MS=300000

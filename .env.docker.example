# Sao chép thành .env ở thư mục gốc repo rồi đổi các giá trị bên dưới trước khi chạy docker compose.
# SQL Server yêu cầu mật khẩu mạnh: ít nhất 8 ký tự, có chữ hoa, chữ thường, số và ký hiệu.
SQL_PASSWORD=ChangeMe-Strong-Passw0rd!
MONGO_USER=admin
# Mật khẩu MongoDB nằm trong chuỗi kết nối: chỉ dùng chữ, số, dấu gạch ngang hoặc gạch dưới.
MONGO_PASSWORD=change-me-mongo-password

# Khoá ký JWT: chuỗi ngẫu nhiên dài, ví dụ tạo bằng
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Khoá mã hoá các bí mật lưu trong DB (khoá OpenAI nhập ở trang quản trị). Chuỗi ngẫu nhiên dài; đổi thì phải nhập lại khoá.
SETTINGS_SECRET=

# Địa chỉ người dùng mở website (dùng cho link trả về từ VNPay)
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Cookie đăng nhập chỉ gửi qua HTTPS (localhost vẫn được). Mở website qua http bằng IP LAN thì đặt false.
COOKIE_SECURE=true

# VNPay sandbox (để trống nếu chưa đăng ký)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_UPDATE_ON_RETURN=true

# Thông tin cửa hàng hiển thị trên website (header, trang Chính sách, nút Zalo)
STORE_PHONE=0338446502
STORE_EMAIL=
STORE_ADDRESS=
RETURN_DAYS=7
# Số kỹ thuật viên (số lịch tối đa mỗi khung giờ) và số ngày mở đặt lịch dịch vụ tại nhà
SERVICE_SLOT_CAPACITY=2
SERVICE_BOOKING_DAYS=14

# Trợ lý mua hàng (OpenAI). Để trống thì tắt. Không commit khoá thật.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ASSISTANT_MAX_PER_HOUR=20
ASSISTANT_DAILY_LIMIT=500
